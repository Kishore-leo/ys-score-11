# Database
DATABASE_URL=postgresql://user:password@localhost:5432/ys_score_11

# JWT
SECRET_KEY=your-super-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Cricket Data API (replace with your licensed provider)
CRICKET_API_KEY=your_cricket_api_key
CRICKET_API_BASE_URL=https://api.cricketdata.org/api/v1

# Firebase (for push notifications)
FIREBASE_CREDENTIALS_PATH=./firebase-credentials.json

# Google Play / App Store verification
GOOGLE_PLAY_PACKAGE_NAME=com.youngstorms.ys_score_11
APPLE_BUNDLE_ID=com.youngstorms.ysscore11
APPLE_SHARED_SECRET=your_apple_shared_secret

# App
APP_ENV=development
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080
